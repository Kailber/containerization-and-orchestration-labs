      "id": "4803cf1c-ec6d-460b-97ca-b0dec0379f11",
      "name": "Get Tags",
      "credentials": {
        "githubApi": {
          "id": "NQZvXqZ8mkpIXOhZ",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const tags = $input.all()\n  .map(item => item.json)\n  .flatMap(item => Array.isArray(item) ? item : [item])\n  .sort((a, b) => b.name.localeCompare(a.name, undefined, {\n    numeric: true,\n  }));\n\nif (tags.length < 2) {\n  throw new Error('Нужно как минимум два тега для сравнения');\n}\n\nreturn [\n  {\n    json: {\n      owner: $('Repository Config').first().json.owner,\n      repo: $('Repository Config').first().json.repo,\n      newTag: tags[0].name,\n      prevTag: tags[1].name,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "6f6f65ff-cac0-48f5-b8b9-421b0dfbb144",
      "name": "Select Tags"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}/releases?per_page=100",
