      "id": "8cdfc2d2-0556-4a14-b38b-11bf3e8805af",
      "name": "Release Exists?"
    },
    {
      "parameters": {
        "jsCode": "const config = $('Select Tags').first().json;\nconst releases = $input.all().map(item => item.json);\n\nconst exists = releases.some(\n  release => release.tag_name === config.newTag\n);\n\nreturn [{\n  json: {\n    ...config,\n    releaseExists: exists,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "id": "a761f16d-6f7d-4e06-9657-e347a9bb9e99",
      "name": "Check Release"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}/compare/{{ $json.prevTag }}...{{ $json.newTag }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1568,
        96
      ],
      "id": "4a26e3f1-17fa-4fc9-870c-c961cbf1b9e2",
      "name": "Compare Tags",
      "credentials": {
        "githubApi": {
          "id": "NQZvXqZ8mkpIXOhZ",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const comparison = $input.first().json;\n\nconst prNumbers = [\n  ...new Set(\n    comparison.commits.flatMap(commit => {\n      const message = commit.commit.message;\n      return [...message.matchAll(/\\(#(\\d+)\\)/g)]\n        .map(match => Number(match[1]));\n    })\n  ),\n].sort((a, b) => a - b);\n\nreturn [\n  {\n    json: {\n      owner: $('Select Tags').first().json.owner,\n      repo: $('Select Tags').first().json.repo,\n      prevTag: $('Select Tags').first().json.prevTag,\n      newTag: $('Select Tags').first().json.newTag,\n      prNumbers,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        96
      ],
      "id": "ca3df38b-4abd-4001-ba1d-1754181a0da1",
      "name": "Extract PR Numbers"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json) }}",
        "options": {
          "systemMessage": "Ты — AI-агент команды проекта «Кебабернетес», готовящий release notes на русском языке.\n\nПеред обработкой входных данных вызови Filesystem MCP `read_multiple_files` **один раз**, передав пути:\n\n- `skills/release-notes.md`\n- `business-context.md`\n- `release-rules.md`\n\nИспользуй содержимое всех трёх файлов как единый контекст. Не вызывай отдельные инструменты чтения для этих файлов без необходимости. Если чтение не удалось или какой-либо файл отсутствует в результате, не выдумывай его содержимое.\n\nСледуй инструкциям `skills/release-notes.md`. Обработай каждый PR из переданного списка.\n\nВерни только готовый текст release notes на русском языке в формате, указанном в skill.",
          "maxIterations": 25
        }
      },
